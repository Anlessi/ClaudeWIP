# Copy this file to .env.local and set your own values. .env.local is not committed.

# 6-digit PIN required to open the app during testing.
VITE_ACCESS_PIN=000000

# Google OAuth client ID for reading your Google Calendar (optional; without it the app keeps the sample events).
# It is not a secret, but it is still set here per machine. See "Google Calendar" in the README for how to create one.
VITE_GOOGLE_CLIENT_ID=
